generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// Auth.js models
// =============================================================

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  bodyPhotoUrl          String?
  gender                String?
  password              String?
  role                  String    @default("user")
  preferredStyle        String?
  preferredColorPalette String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  wardrobe   WardrobeItem[]
  outfits    Outfit[]
  savedLooks SavedLook[]
  favorites  Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================
// Wardrobe
// =============================================================

model WardrobeItem {
  id             String   @id @default(cuid())
  userId         String
  name           String
  imageUrl       String
  category       String
  color          String
  secondaryColor String?
  pattern        String?
  material       String?
  occasion       String?
  season         String?
  style          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
  favorites   Favorite[]

  @@index([userId])
  @@index([category])
  @@index([color])
  @@index([style])
}

model Outfit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  occasion  String?
  style     String?
  lookData     Json?
  aiTryOnUrl   String?
  aiTryOnStatus String   @default("idle")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OutfitItem[]
  savedLook SavedLook?

  @@index([userId])
}

model OutfitItem {
  id             String  @id @default(cuid())
  outfitId       String
  wardrobeItemId String

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItem WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@unique([outfitId, wardrobeItemId])
}

model SavedLook {
  id          String   @id @default(cuid())
  userId      String
  outfitId    String   @unique
  name        String
  description String?
  lookData    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfit    Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([userId])
}

model Favorite {
  id             String   @id @default(cuid())
  userId         String
  savedLookId    String?
  trendId        String?
  wardrobeItemId String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedLook    SavedLook?    @relation(fields: [savedLookId], references: [id], onDelete: Cascade)
  trend        Trend?        @relation(fields: [trendId], references: [id], onDelete: Cascade)
  wardrobeItem WardrobeItem? @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@unique([userId, savedLookId, trendId, wardrobeItemId])
  @@index([userId])
}

// =============================================================
// Trend Setter catalog
// =============================================================

model Trend {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  style       String?
  occasion    String?
  season      String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     TrendItem[]
  favorites Favorite[]

  @@index([style])
}

model TrendItem {
  id      String  @id @default(cuid())
  trendId String
  section String
  name    String
  detail  String?

  trend Trend @relation(fields: [trendId], references: [id], onDelete: Cascade)

  @@index([trendId])
}

// =============================================================
// Recommendation catalogs
// =============================================================

model Jewelry {
  id          String   @id @default(cuid())
  name        String
  type        String
  color       String?
  material    String?
  style       String?
  occasion    String?
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([style])
  @@index([occasion])
}

model Accessory {
  id          String   @id @default(cuid())
  name        String
  type        String
  color       String?
  style       String?
  occasion    String?
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([style])
  @@index([occasion])
}

model StyleRecommendation {
  id          String   @id @default(cuid())
  category    String
  itemType    String
  name        String
  imageUrl    String?
  color       String?
  style       String?
  occasion    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([style])
  @@index([occasion])
}

model ColorMatch {
  id         String   @id @default(cuid())
  baseColor  String
  matchColor String
  metalTone  String?
  category   String?
  priority   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([baseColor])
}
